{
  "name": "ielts-passport-mobile",
  "version": "1.0.7",
  "private": true,
  "description": "IELTS Passport Android and iOS application",
  "scripts": {
    "prepare:web": "node scripts/copy-web.mjs",
    "sync": "pnpm prepare:web && cap sync",
    "add:android": "pnpm prepare:web && cap add android",
    "add:ios": "pnpm prepare:web && cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
